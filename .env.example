# Copy to .env and fill in. sptree reads .env from the directory you run it in;
# variables already set in your shell take precedence. .env is git-ignored.

# Entra app registration -> Overview (see README "Set up sign-in")
SPTREE_CLIENT_ID=00000000-0000-0000-0000-000000000000
SPTREE_TENANT=contoso.onmicrosoft.com

# Optional
# SPTREE_ADDR=127.0.0.1:8765
# SPTREE_TOKEN_CACHE=/path/to/token.json
# SPTREE_GRAPH_URL=https://graph.microsoft.com/v1.0
# SPTREE_LOGIN_URL=https://login.microsoftonline.com
